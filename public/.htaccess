<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/wasm .wasm
</IfModule>

<IfModule mod_headers.c>
  # Studio uses the existing GA4 property and Google Fonts. Keep these
  # permissions within Studio while retaining the inherited site policy.
  Header always edit Content-Security-Policy "script-src 'self'" "script-src 'self' https://www.googletagmanager.com"
  Header always edit Content-Security-Policy "style-src 'self' 'unsafe-inline'" "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com"
  Header always edit Content-Security-Policy "font-src 'self' data:" "font-src 'self' data: https://fonts.gstatic.com"
  Header always edit Content-Security-Policy "connect-src 'self'" "connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com"
  <Files "index.html">
    Header always set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /tools/swishiq-studio/
  # Old Studio document routes hand off to the React workspace even when a
  # legacy directory still exists for support assets.
  RewriteRule ^career(?:/index\.html)?/?$ analytics/career [R=301,L]
  RewriteRule ^game(?:/index\.html)?/?$ sims/game [R=301,L]
  RewriteRule ^season(?:/index\.html)?/?$ sims/season [R=301,L]
  RewriteRule ^(?:chemistry|forge|spin|players(?:/(?:compare|dossier))?)(?:/index\.html)?/?$ index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Rewrite app routes only. Missing data, native modules and assets stay 404.
  RewriteRule ^(?:sims(?:/(?:season|game|franchise))?|analytics(?:/career)?|players(?:/[^.]*)?|chemistry|forge|forge-models|spin|book|real-book|daily-games(?:/(?:fix-the-five|draft-night))?|lineup-lab|tools/shared-result|pool-mockup|collector|matchups|packs|playbook|workshop|account|login|register|forgot-password|reset-password|oauth-consent)/?$ index.html [L]
</IfModule>
